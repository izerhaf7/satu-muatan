# Salin ke .env dan sesuaikan. Jangan pernah commit .env berisi rahasia.
#
# Nilai di bawah adalah untuk PENGEMBANGAN LOKAL (docker-compose.yml + venv).
# Untuk PRODUKSI (Render/Railway, spec §3.3), env var yang sama diisi lewat
# dashboard platform — TIDAK PERNAH lewat file .env yang di-commit. Detail
# klik-demi-klik ada di README.md bagian "Deploy".

# Connection string Postgres. Lokal: kontainer docker-compose (port 5433, lihat
# CLAUDE.md soal 127.0.0.1 vs localhost di Windows). Produksi: connection string
# dari Neon/Supabase (region Singapore, spec §3.3) — psycopg butuh prefix
# "postgresql+psycopg://", BUKAN "postgres://" bawaan Neon/Supabase (ganti skema-nya).
DATABASE_URL=postgresql+psycopg://satu_muatan:satu_muatan_dev@127.0.0.1:5433/satu_muatan

# String acak panjang untuk menandatangani JWT sesi login. Lokal: nilai apa pun
# boleh. Produksi: WAJIB diganti nilai acak sungguhan (Render blueprint men-generate
# otomatis lewat `generateValue: true`, lihat render.yaml) -- jangan pernah dipakai
# ulang antar-lingkungan.
JWT_SECRET=ganti-dengan-string-acak-panjang

# MOCK (default, dipakai demo -- deterministik, tanpa kredensial vendor sungguhan)
# atau DELIVEREE (kerangka adapter, menunggu kredensial -- spec §12 melarang
# integrasi vendor sungguhan untuk lomba ini). Sama di lokal maupun produksi.
VENDOR_ADAPTER=MOCK

# true: aktifkan POST /api/auth/masuk-demo + POST /api/demo/reset (tombol masuk
# cepat & reset skenario demo, spec §9.1/§11.2). Tetap true di produksi selama
# masa lomba -- juri memakai jalur ini. Set false HANYA kalau demo sudah selesai
# dan endpoint ini perlu dimatikan.
DEMO_MODE=true

# Origin yang boleh mengakses API (CORS) -- daftar dipisah koma, TANPA spasi
# setelah koma, TANPA trailing slash. Lokal: origin dev server Vite. Produksi:
# ganti/tambahkan origin Vercel produksi, mis.
# "https://satu-muatan.vercel.app,http://localhost:5173" -- JANGAN pernah "*"
# di produksi (spec §3.3).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PORT: HANYA relevan untuk `docker run` lokal (default 8000 di
# backend/docker-entrypoint.sh kalau tidak diset). Di Render/Railway, platform
# menyuntikkan PORT sendiri secara otomatis -- JANGAN diisi manual di dashboard.

# GOOGLE_MAPS_API_KEY: kunci SERVER Google Routes API (opsional) -- dibatasi IP
# (IP-restricted), bukan referrer. Mengaktifkan polyline jalan sungguhan + ETA
# untuk rute (provider AUTO). Kosong -> fallback haversine (demo offline tetap
# jalan). JANGAN pernah menaruh kunci ini di variabel VITE_*/frontend.
GOOGLE_MAPS_API_KEY=

# true (default): entrypoint menjalankan `alembic upgrade head` sebelum Uvicorn,
# mempertahankan perilaku Render/Railway. Cloud Run runtime WAJIB memakai false:
# migration job serial menjalankan `alembic upgrade head` sebelum revision dibuat
# tanpa traffic. Jangan masukkan nilai rahasia ke file ini.
RUN_MIGRATIONS=true
