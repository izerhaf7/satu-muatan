# Kunci browser Google Maps — WAJIB dibatasi referrer (HTTP referrer) di
# Google Cloud Console: tambahkan http://localhost:5173 (lokal) dan domain
# Vercel produksi (mis. https://satu-muatan.vercel.app/*). JANGAN pernah
# memakai server key / GOOGLE_MAPS_API_KEY di sini (kunci server tidak boleh
# masuk browser).
VITE_GOOGLE_MAPS_KEY=

# Map ID tipe "Vector" — wajib untuk AdvancedMarkerElement.
# Buat di: Google Maps Platform → Maps JavaScript API → Map IDs → Create Map ID
# (atau Google Cloud Console → Maps Platform → Map Management).
VITE_GOOGLE_MAPS_ID=